# Salin menjadi .env lalu sesuaikan:  cp .env.example .env

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=ai_chat

# --- Auth (WAJIB diganti). Buat dengan:  openssl rand -hex 32 ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Token bersama backend <-> aichat (boleh kosong untuk lokal) ---
AI_SERVICE_TOKEN=

# --- Web ---
# Port aplikasi di mesin host -> http://localhost:8080
WEB_PORT=8080

# --- AI provider: "ollama", "huggingface", atau "openai" (kompatibel OpenAI, mis. Groq) ---
DEFAULT_PROVIDER=ollama

# Ollama di mesin host (jalankan host dengan OLLAMA_HOST=0.0.0.0 agar bisa dijangkau dari container).
# Jika memakai profile "ollama" di compose, ganti menjadi http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# OpenAI-compatible (DEFAULT_PROVIDER=openai). Default: Groq (https://console.groq.com)
# Provider lain: Cerebras https://api.cerebras.ai/v1 , OpenRouter https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.1-8b-instant

# Hugging Face
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=gpt2

# Kosongkan (disarankan): frontend memakai path relatif lewat proxy Nginx.
# Isi hanya jika API di domain lain. Nilai ini ikut di-build ke frontend.
VITE_API_BASE=
