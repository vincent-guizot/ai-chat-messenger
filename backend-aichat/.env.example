# Server
PORT=3001
CORS_ORIGIN=*

# Token bersama dengan backend-core (AI_SERVICE_TOKEN di sana harus sama persis).
# Kosong = endpoint /api/ai/reply bisa dipanggil tanpa token (cukup untuk development lokal).
AI_SERVICE_TOKEN=

# # AI provider: "ollama", "huggingface", atau "openai" (kompatibel OpenAI, mis. Groq)

# Lokal
# DEFAULT_PROVIDER=ollama

# Ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Cloud
# OpenAI-compatible (DEFAULT_PROVIDER=openai). Default: Groq (https://console.groq.com)
DEFAULT_PROVIDER=openai
# Provider lain: Cerebras https://api.cerebras.ai/v1 , OpenRouter https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-20b

# Hugging Face
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=gpt2
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models
