# Server
PORT=3000
CORS_ORIGIN=*

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chat?schema=public
# Optional: separate database used by `npm test` (defaults to <database>_test)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chat_test?schema=public

# Auth (di production minimal 16 karakter; buat dengan: openssl rand -hex 32)
JWT_SECRET=your_super_secret_key
JWT_EXPIRES_IN=7d

# Service AI (backend-aichat). Semua konfigurasi provider (Ollama/OpenAI/Hugging Face) ada di sana.
AI_SERVICE_URL=http://localhost:3001
# Isi jika backend-aichat dijalankan dengan AI_SERVICE_TOKEN (harus sama persis). Kosong = tanpa token.
AI_SERVICE_TOKEN=
