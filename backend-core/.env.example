# Server
PORT=3000
CORS_ORIGIN=*

# Database (PostgreSQL)
DATABASE_URL=
# Optional: separate database used by `npm test` (defaults to <database>_test)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chat_test?schema=public

# Auth (di production minimal 16 karakter; buat dengan: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Service AI (backend-aichat). Semua konfigurasi provider (Ollama/OpenAI/Hugging Face) ada di sana.
AI_SERVICE_URL=https://chibi-ai-2mba.onrender.com
# Isi jika backend-aichat dijalankan dengan AI_SERVICE_TOKEN (harus sama persis). Kosong = tanpa token.
AI_SERVICE_TOKEN=

# --- Deploy (Neon + Render) ---
# DATABASE_URL  : connection string "pooled" dari Neon (host mengandung -pooler).
# DATABASE_URL_UNPOOLED : connection string langsung Neon, hanya dipakai untuk `prisma migrate deploy`.
# SKIP_DB_CREATE=true   : lewati CREATE DATABASE (otomatis untuk host *.neon.tech).
# CORS_ORIGIN           : isi dengan URL frontend Vercel, tanpa slash di akhir (https://nama.vercel.app).
# DATABASE_URL_UNPOOLED=
# SKIP_DB_CREATE=
