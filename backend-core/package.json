{
  "name": "ai-chat-messenger-backend-core",
  "version": "1.0.0",
  "description": "Core backend for AI Chat Messenger (Express + Socket.IO + Prisma + PostgreSQL). AI replies are delegated to backend-aichat.",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prestart": "npm run db:prepare",
    "start": "node src/server.js",
    "predev": "npm run db:prepare",
    "dev": "nodemon src/server.js",
    "db:create": "node scripts/create-database.js",
    "db:migrate": "node scripts/check-migrations.js && node scripts/migrate-deploy.js",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:prepare": "npm run db:create && npm run db:migrate",
    "db:setup": "npm run db:prepare && npm run db:seed",
    "db:reset": "prisma migrate reset --force",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "jest --runInBand"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
