# Server
PORT=3000
CORS_ORIGIN=*

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chat?schema=public
# Optional: separate database used by `npm test` (defaults to <database>_test)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chat_test?schema=public

# Auth
JWT_SECRET=your_super_secret_key
JWT_EXPIRES_IN=7d

# AI provider: "ollama", "huggingface", or "openai" (OpenAI-compatible, e.g. Groq)
DEFAULT_PROVIDER=ollama

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI-compatible (DEFAULT_PROVIDER=openai). Default: Groq (https://console.groq.com)
# Provider lain: Cerebras https://api.cerebras.ai/v1 , OpenRouter https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.1-8b-instant

# Hugging Face
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=gpt2
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models
