{
  "name": "ai-chat-messenger-backend",
  "version": "0.4.0",
  "description": "Backend for AI Chat Messenger (Sequelize)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "axios": "1.7.9",
    "bcrypt": "5.1.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.7",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "3.1.10",
    "sequelize-cli": "6.6.5",
    "supertest": "7.1.4",
    "socket.io-client": "4.8.1"
  }
}
