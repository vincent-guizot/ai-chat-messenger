{
  "name": "ai-chat-messenger-backend",
  "version": "0.4.0",
  "description": "Backend for AI Chat Messenger (Sequelize)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:create": "npx sequelize-cli db:create",
