# Kosongkan VITE_API_BASE saat development: Vite akan mem-proxy /api dan /socket.io ke VITE_BACKEND_URL.
# Isi VITE_API_BASE jika frontend di-deploy terpisah dari backend (contoh: https://api.domain.com).
VITE_API_BASE=
VITE_BACKEND_URL=http://localhost:3000

# Deploy Vercel: set VITE_API_BASE di Project Settings -> Environment Variables
# ke URL publik backend-core di Render (https://chibi-core.onrender.com), tanpa slash di akhir.
